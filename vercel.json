{
  "version": 2,
  "builds": [
    {
      "src": "src/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/portfolio/update",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/articles/sync",
      "schedule": "0 2 * * *"
    }
  ]
}
